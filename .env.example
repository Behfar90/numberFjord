# Copy to .env.local and fill in. Never commit real keys.

# Vercel AI Gateway key: https://vercel.com/d?to=/[team]/~/ai-gateway/api-keys
# Not needed on Vercel deployments, which authenticate with OIDC.
AI_GATEWAY_API_KEY=

# Gateway model ID (provider/model). Leave empty for the default in
# src/lib/agent/model.ts, e.g. AGENT_MODEL=anthropic/claude-sonnet-5.5
AGENT_MODEL=
